# ==============================================================================
# RESTAURANT SAAS — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# IMPORTANT:
# 1. Never commit real credentials or production secrets to source control.
# 2. Use unique, cryptographically strong random values for all secrets.
# 3. In production, provide environment variables via container orchestration,
#    cloud secrets managers (AWS Secrets Manager, GCP Secret Manager, Vault),
#    or deployment platforms (Vercel, Railway, Render, Fly.io, Kubernetes).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & RUNTIME SETTINGS
# ------------------------------------------------------------------------------
NODE_ENV="production"
PORT=3000
HOSTNAME="0.0.0.0"

# Public application base URL (used for links, invites, and QR code generation)
NEXT_PUBLIC_APP_URL="https://app.yourdomain.com"
APP_URL="https://app.yourdomain.com"

# Build configuration: Set to "true" to generate standalone output for Docker containers
BUILD_STANDALONE="true"

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# SQLite (Single-node / Persistent Volume):
# DATABASE_URL="file:./dev.db"
#
# PostgreSQL (Multi-node / Cloud Managed / Recommended for high-concurrency SaaS):
# DATABASE_URL="postgresql://db_user:db_password@postgres-host:5432/restaurant_saas?schema=public&sslmode=require&connection_limit=20"
DATABASE_URL="file:./dev.db"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Minimum 32-character high-entropy secret used for JWT signing and session cookies.
# Generate with: openssl rand -base64 32
JWT_SECRET="replace_with_a_secure_random_32_character_secret_key"

# Optional: Set cookie domain for multi-tenant subdomain routing (e.g., .yourdomain.com)
# COOKIE_DOMAIN=".yourdomain.com"

# Force secure cookies regardless of NODE_ENV (defaults to true in production)
# SECURE_COOKIES="true"

# ------------------------------------------------------------------------------
# 4. INITIAL PLATFORM SUPER ADMIN (OPTIONAL CLI PROVISIONING)
# ------------------------------------------------------------------------------
# Used only by scripts/provision-super-admin.js for initial bootstrapping
SUPER_ADMIN_EMAIL="admin@yourdomain.com"
SUPER_ADMIN_PASSWORD="replace_with_a_strong_bootstrap_password"
SUPER_ADMIN_NAME="Platform Super Admin"

# ------------------------------------------------------------------------------
# 5. PLATFORM BILLING & SUBSCRIPTIONS (RAZORPAY)
# ------------------------------------------------------------------------------
# Credentials for tenant subscription billing (Pro, Growth, Enterprise plans)
# Test mode keys start with 'rzp_test_', Live mode keys start with 'rzp_live_'
SAAS_BILLING_RAZORPAY_KEY_ID="rzp_test_placeholder_key_id"
SAAS_BILLING_RAZORPAY_KEY_SECRET="rzp_test_placeholder_key_secret"
SAAS_BILLING_WEBHOOK_SECRET="whsec_placeholder_billing_webhook_secret"

# ------------------------------------------------------------------------------
# 6. RESTAURANT ORDER CHECKOUT & PAYMENTS (RAZORPAY)
# ------------------------------------------------------------------------------
# Default / platform payment gateway credentials for customer table orders
RAZORPAY_KEY_ID="rzp_test_placeholder_key_id"
RAZORPAY_KEY_SECRET="rzp_test_placeholder_key_secret"
RAZORPAY_WEBHOOK_SECRET="whsec_placeholder_payments_webhook_secret"

# ------------------------------------------------------------------------------
# 7. EXTERNAL HARDWARE & COMMUNICATION INTEGRATIONS (OPTIONAL)
# ------------------------------------------------------------------------------
# Local network thermal printer bridge (ESC/POS)
# LOCAL_PRINTER_BRIDGE_URL="http://192.168.1.100:9100"

# SMTP Transactional Email (SendGrid, Postmark, AWS SES, Resend)
# SMTP_HOST="smtp.provider.com"
# SMTP_PORT="587"
# SMTP_USER="apikey_or_username"
# SMTP_PASS="placeholder_smtp_password"
# SMTP_FROM="receipts@yourdomain.com"

# WhatsApp Cloud API / Gateway
# WHATSAPP_API_TOKEN="placeholder_whatsapp_bearer_token"
# WHATSAPP_PHONE_NUMBER_ID="placeholder_phone_number_id"

# ------------------------------------------------------------------------------
# 8. OBSERVABILITY, LOGGING & MONITORING
# ------------------------------------------------------------------------------
# Log level: "debug" | "info" | "warn" | "error"
LOG_LEVEL="info"

# Health check detail level (if true, authenticated Super Admin can inspect detailed DB latency)
ENABLE_DETAILED_HEALTH="true"
